{
  "version": "0.2.0",
  "robot": {
    "id": "demo-0",
    "name": "EOS v2 demo"
  },
  "cores": {
    "isos": {
      "layers": {
        "eos_hardware": {
          "groups": {
            "camera": {
              "nodes": {
                "front": {
                  "id": "front",
                  "node_type": "isos.eos_hardware.camera@v0.2",
                  "label": "Front RGB-D camera",
                  "description": "Loopback aligned RGB and depth frames",
                  "frame_id": "front_camera_optical",
                  "capabilities": [
                    "rgb8",
                    "aligned_depth_u16"
                  ],
                  "adapter": {
                    "type": "mock-cxx"
                  },
                  "health_timing": {
                    "poll_interval_ms": 100,
                    "stale_after_ms": 500
                  },
                  "observation": {
                    "max_rate_hz": 30.0,
                    "max_payload_bytes": 8388608
                  },
                  "references": []
                }
              }
            },
            "base": {
              "nodes": {
                "drive": {
                  "id": "drive",
                  "node_type": "isos.eos_hardware.base@v0.2",
                  "label": "Planar base",
                  "description": "Loopback differential drive controller",
                  "frame_id": "base_link",
                  "capabilities": [
                    "body_velocity"
                  ],
                  "adapter": {
                    "type": "mock-cxx"
                  },
                  "health_timing": {
                    "poll_interval_ms": 100,
                    "stale_after_ms": 500
                  },
                  "observation": {
                    "max_rate_hz": 50.0,
                    "max_payload_bytes": 4096
                  },
                  "movement": {
                    "modes": [
                      "body_velocity"
                    ],
                    "limits": {
                      "max_linear_m_s": 1.0,
                      "max_angular_rad_s": 1.5,
                      "max_velocity_lease_ms": 500,
                      "max_translation_m": 5.0,
                      "max_rotation_rad": 3.14159
                    }
                  },
                  "inputs": {
                    "command": [
                      {
                        "node": "isos/eos_dispatcher/base/velocity",
                        "output": "command"
                      }
                    ]
                  },
                  "references": []
                }
              }
            },
            "manipulator": {
              "nodes": {
                "arm": {
                  "id": "arm",
                  "node_type": "isos.eos_hardware.manipulator@v0.2",
                  "label": "Six axis arm",
                  "description": "Loopback joint and Cartesian command receiver",
                  "frame_id": "arm_base",
                  "joint_names": [
                    "joint1",
                    "joint2",
                    "joint3",
                    "joint4",
                    "joint5",
                    "joint6"
                  ],
                  "capabilities": [
                    "joint_positions",
                    "end_effector_pose"
                  ],
                  "adapter": {
                    "type": "mock-cxx"
                  },
                  "health_timing": {
                    "poll_interval_ms": 100,
                    "stale_after_ms": 500
                  },
                  "observation": {
                    "max_rate_hz": 50.0,
                    "max_payload_bytes": 4096
                  },
                  "movement": {
                    "modes": [
                      "joint_positions",
                      "end_effector_pose"
                    ],
                    "limits": {
                      "max_joint_position_rad": 3.14,
                      "max_joint_speed_rad_s": 1.0,
                      "max_end_effector_speed_m_s": 0.2,
                      "max_end_effector_translation_m": 1.0
                    }
                  },
                  "inputs": {
                    "command": [
                      {
                        "node": "isos/eos_dispatcher/manipulator/movej",
                        "output": "command"
                      }
                    ]
                  },
                  "references": []
                }
              }
            }
          }
        },
        "eos_dispatcher": {
          "groups": {
            "control": {
              "nodes": {
                "command": {
                  "id": "command",
                  "node_type": "isos.eos_dispatcher.control@v0.2",
                  "label": "EOS command dispatcher",
                  "description": "Software node that admits movement through configured hardware nodes",
                  "capabilities": [
                    "admission",
                    "status"
                  ],
                  "references": [
                    "isos/eos_hardware/base/drive",
                    "isos/eos_hardware/manipulator/arm"
                  ],
                  "inputs": {}
                }
              }
            },
            "base": {
              "nodes": {
                "velocity": {
                  "id": "velocity",
                  "node_type": "isos.eos_dispatcher.primitive_base@v0.2",
                  "label": "Base velocity",
                  "description": "Governed base primitive binding",
                  "settings": {
                    "primitive_name": "base.velocity",
                    "primitive_version": "1.0.0",
                    "movement_type": "body_velocity"
                  }
                }
              }
            },
            "manipulator": {
              "nodes": {
                "movej": {
                  "id": "movej",
                  "node_type": "isos.eos_dispatcher.primitive_manipulator@v0.2",
                  "label": "Arm movej",
                  "description": "Governed arm primitive binding",
                  "settings": {
                    "primitive_name": "arm.movej",
                    "primitive_version": "1.0.0",
                    "movement_type": "joint_positions"
                  }
                }
              }
            }
          }
        },
        "eos_interface": {
          "groups": {
            "gate": {
              "nodes": {
                "front": {
                  "id": "front",
                  "node_type": "isos.eos_interface.camera_gate@v0.2",
                  "label": "Front preview",
                  "description": "Read-only camera gate",
                  "inputs": {
                    "frame": {
                      "node": "isos/eos_hardware/camera/front",
                      "output": "frame",
                      "priority": -20,
                      "frequency_hz": 15.0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
