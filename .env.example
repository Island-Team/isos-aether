# Repository-local secrets and development tunnel settings.
# Copy this file to .env in the repository root and fill only values you need.
# EI runtime settings belong in config/ei/*.toml (or an EI deployment TOML overlay).

# API credentials selected by EI model and speech bindings.
#EI_MODEL_API_KEY=
#SANLANG_BIGMODEL_API_KEY=
#ALIYUN_MAAS_API_KEY=
#MOONSHOT_API_KEY=
#OPENAI_API_KEY=
#EI_ASR_API_KEY=
#EI_TTS_API_KEY=

# Development SSH tunnels used by ei/scripts/ssh-tunnel.sh.
#SSH_TUNNELS="lab"
#SSH_TUNNEL_LAB="developer@robot.example.com:22 50051 8000"
#SSH_TUNNEL_LAB_PASSWORD_ENV=LAB_SSH_PASSWORD
#LAB_SSH_PASSWORD=
